{
  "model": {
    "d_model": 128,
    "num_layers": 4,
    "num_heads": 4,
    "ff_dim": 512,
    "dropout": 0.1,
    "compile_mode": "default",
    "attn_impl": "flash"
  },
  "training": {
    "num_episodes": 250000,
    "warmup_steps": 1000,
    "batch_size": 512,
    "buffer_size": 200000,
    "update_freq": null,
    "gradient_steps": 1,
    "lr": 3e-4,
    "grad_clip": 1.0,
    "gamma": 0.99,
    "tau": 5e-3,
    "alpha": 0.2,
    "auto_alpha": false,
    "target_entropy": null,
    "max_steps": 500
  },
  "td_lambda": {
    "enabled": true,
    "lambda": 0.9,
    "cache_size": 8000,
    "block_size": 30,
    "refresh_freq": 1000
  },
  "environment": {
    "backend": "jax",
    "opponent": "agent1",
    "n_players_default": 2,
    "ratio_4p": 0.0,
    "mixed_send_prob": 0.5,
    "tanh_scale": 0.6,
    "min_fleet_ships": 8
  },
  "jax_env": {
    "num_envs": 512,
    "actor": "serial",
    "episode_steps": 500
  },
  "reward": [
    {"scheme": "ShipGrowth", "ship_scale": 0.02,  "loss_scale": 3.0},
    {"scheme": "ProductionPlanetDelta", "planet_scale": 1.0, "loss_scale": 5.0},
    {"scheme": "TimeDecayWinBonus", "win_bonus": 5.0}
  ],
  "io": {
    "log_dir": "runs/v13_st2",
    "ckpt_dir": "checkpoints/v13_st2",
    "render_dir": "replays/v13_st2",
    "render_interval": 500,
    "save_interval": 500,
    "log_interval": 100
  },
  "execution": {
    "device": "auto",
    "cpu_force": false,
    "seed": null,
    "resume": null
  }
}
