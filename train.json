{
  "model": {
    "d_model": 128,
    "num_layers": 2,
    "num_heads": 4,
    "ff_dim": 512,
    "dropout": 0.1
  },
  "training": {
    "num_episodes": 250,
    "warmup_steps": 500,
    "batch_size": 256,
    "buffer_size": 100000,
    "update_freq": null,
    "gradient_steps": 1,
    "lr": 3e-4,
    "grad_clip": 1.0,
    "gamma": 0.99,
    "tau": 5e-3,
    "alpha": 0.2,
    "auto_alpha": false,
    "target_entropy": null,
    "max_steps": 500
  },
  "td_lambda": {
    "enabled": false,
    "lambda": 0.9,
    "cache_size": 8000,
    "block_size": 50,
    "refresh_freq": 1000
  },
  "environment": {
    "backend": "jax",
    "opponent": "rule_based",
    "n_players_default": 2,
    "ratio_4p": 0.3,
    "mixed_send_prob": 0.3,
    "tanh_scale": 0.2,
    "min_fleet_ships": 3
  },
  "jax_env": {
    "num_envs":     256,
    "num_players":  2,
    "episode_steps": 500,
    "reward_type":  "ship_advantage",
    "reward_scale": 0.01,
    "win_bonus":    100.0
  },
  "curriculum": {
    "mixed_random_ratio_start": 1.0,
    "mixed_random_ratio_end": 0.0,
    "mixed_random_ratio_decay": null,
    "mixed_random_ratio_schedule": "linear"
  },
  "reward": [
    {
      "scheme": "AbsoluteHoldings",
      "ship_scale": 0.5,
      "planet_scale": 1.0
    },
    {
      "scheme": "FleetLaunchPenalty",
      "ship_scale": 1.0
    },
    {
      "scheme": "TimeDecayWinBonus",
      "win_bonus": 1000
    }
  ],
  "io": {
    "log_dir": null,
    "ckpt_dir": "checkpoints",
    "render_dir": "replays",
    "render_interval": 10,
    "save_interval": 100,
    "log_interval": 1
  },
  "execution": {
    "device": "auto",
    "cpu_force": false,
    "seed": null,
    "resume": null
  }
}
